---
{
	"title": "Example HTML 5",
	"language": "en",
	"category": "Plugins",
	"description": "Leverage HTML 5 template element by using the data json plugin.",
	"tag": "data-json",
	"parentdir": "wb-data-json",
	"altLangPage": "template-fr.html",
	"dateModified": "2022-10-12"
}
---


<div >
<dl class="dl-horizontal" data-dl>
	<dt>Title 1</dt>
	<dd>Description 1</dd>

	<dt>Title 2</dt>
	<dd>Description 2</dd>

	<dt>Title 3</dt>
	<dd>Description 3</dd>

	<dt>Title 4</dt>
	<dd>Description 4</dd>

	<dt>Title 5</dt>
	<dd>Description 5</dd>

	<dt>Title 6</dt>
	<dd>Description 6</dd>
</dl>
</div>

// Config extractor
{
	"selector": "dl[data-dl]",
	"path": "/myGroup",
	"mapping": [
		{
			"selector": "dt",
			"path": "/title"
		},
		{
			"selector": "dd",
			"path": "/desc"
		}
	]
}

// Output sample
{
	myGroup:
		[
			{
				title: "Title 1",
				desc: "Description 1"
			},
			{
				title: "Title 2",
				desc: "Description 2"
			},
			{
				title: "Title 3",
				desc: "Description 3"
			},
			{
				title: "Title 4",
				desc: "Description 4"
			},
			{
				title: "Title 5",
				desc: "Description 5"
			},
			{
				title: "Title 6",
				desc: "Description 6"
			},
		]
}


<h2>Sub template</h2>

<div data-wb-jsonmanager='{
		"url": "demo/qwerty.json",
		"name": "example1"
	}'></div>


<!-- This is my form -->
<div>

	<input name="pageTitle" value="" type="text" data-wb-json='{ "url": "#[example1]/pageTitle", "type": "val"}' />
	<input name="submissionPage" value="" type="text" data-wb-json='{ "url": "#[example1]/submissionPage", "type": "val"}' />

	<ul data-wb-json='{
		"url": "#[example1]/pageHeadings",
		"mapping": {
			
			"selector": "li"
			
		}

	}'>
		<template>
			<li></li>
		</template>
	</ul>

	
</div>


<hr />

<h2>Iterate Object</h2>


<div data-wb-json='{
		"url": "#[example1]",
		"mapping": [
		
			{ "selector": "[data-id]", "value": "/@id" },
			{ "selector": "[data-value]", "value": "/@value",

				"mapping": [
					{ "selector": "h3" }
				]

			}
			
		]

	}'>

	<template>
		<p><span data-id></span> - <span data-value>
				<template><h3></h3></template>
			</span></p>
	</template>
	
</div>


<hr />


