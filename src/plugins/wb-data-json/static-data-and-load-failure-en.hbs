<h2>Failing to load a JSON file</h2>

<p>Show a specific message when the fetch is failing, like not found, or when the file is not a valid file</p>

<div data-special data-wb-json='{
	"url": "demo/bad-json-content.json",
	"fail": {
		"data": { "message": "The JSON file specified in the data-json URL is an invalid JSON file." },
		"template": "template",
		"mapping": [
			{
				"selector": "p",
				"value": "/message"
			}
		]
	}
}'>
	<template>
		<div class="alert alert-danger">
			<p></p>
		</div>
	</template>
</div>


<h2>Complementing loaded data with static data</h2>
<div data-wb-json='{
	"url": "demo/import.json",
	"data": {
		"foo": "bar",
		"list": [ "itm1", "itm2", "itm3" ]
	},
	"streamline": true,
	"template": "template",
	"mapping": [
		{
			"selector": "[data-import]",
			"value": "/html/en",
			"encode": true
		}
	]
}'><template><pre><code data-import></code></pre></template></div>
