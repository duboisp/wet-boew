	{
		"action": "data-save-to-input",
		"json-manager": "ID to JSON manager",
		"pointer": "/data/pointer/array/ {{ idx }} /",
		"Flag-no-data-fetch": "Flag to enforce to not trigger automatic update once the data is updated",
		"Flag-if-we-remove|keep-input-on-submit": "Flag to ensure we do have a clean GET submission url. Only the matching input are removed, not the others.",
		"note-": "this.form.inputs are used to match name with properties. Every name are just JSON pointers relative to this action pointer"
	},
	{
		"action": "data-save-local",
		"json-manager": "ID of the JSON manager",
		"local-name": "Humm, set a local storage name, but we can probably use the dataset name.... if not defined.",
		"current-session-only": "Indicator if we should use the session storage instead of the local storage"
	}
]'>
	Save
</button>


<button type="submit">Cancel</button>

</form>


