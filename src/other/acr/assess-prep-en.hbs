<fieldset>
	<legend>Subject</legend>
	<!--
	<label>Type of document
		<select disabled>
			<option selected>Web</option>
			<option>Component in a web page</option>
			<option>Non-web document</option>
			<option>ICT with two-way voice communication</option>
			<option>ICT with video capabilities</option>
			<option>Hardware</option>
			<option>Software</option>
			<option>Documentation and support services</option>
			<option>ICT providing relay or emergency service access</option>
		</select>
	</label>
-->
	<div class="row">
		<div class="col-md-6">

			<p>Subject URLs:</p>
			<ul data-wb-json='
				{
					"url": "#[a11y]/earl:subject/dct:references",
					"mapping": [
						{ "selector": "a", "value": "/@value" },
						{ "selector": "a", "value": "/@value", "attr": "href" },
						{ "selector": "[data-btn-remove]", "value": "/_:iterator", "attr": "path", "placeholder": "[[-id-]]" }
					],
					"removeAll": "li"
				}
			'
			>
				<template>
					<li><a href="">https</a>
						<button type="button" class="btn btn-danger" data-wb-doaction>
							Remove

							<wb-config wb-plugin="wb-doaction">
								<wb-config source="#dsa11y" action="patch" cumulative="true">
									<wb-config wb-prop="patches">
										<wb-config data-btn-remove op="remove" path="/earl:subject/dct:references/[[-id-]]"></wb-config>
									</wb-config>
								</wb-config>
							</wb-config>
						</button>
					</li>
				</template>
			</ul>

			<label>Add URL:
				<input id="addSubjectURL" data-path="/earl:subject/dct:references/-" type="url" placeholder="https://"  data-clean-on-import data-independent-input>
			</label>
			<button type="button" data-wb-doaction>
				Add

				<wb-config wb-plugin="wb-doaction">

					<wb-config source="#dsa11y" action="importInDataset" cumulative="true" inputs="#addSubjectURL"></wb-config>

				</wb-config>
			</button>
		</div>
		<div class="col-md-6">
			<p>Page state being tested</p>
			<ul data-wb-json='
				{
					"url": "#[a11y]/earl:subject/oa:hasState",
					"mapping": [
						{ "selector": "[data-statevalue]", "value": "/acr:stateValue" },
						{ "selector": "[data-btn-remove]", "value": "/_:iterator", "attr": "path", "placeholder": "[[-id-]]" }
					],
					"removeAll": "li"
				}
			'
			>
				<template>
					<li><span data-statevalue></span>
						<button type="button" class="btn btn-danger" data-wb-doaction>
							Remove

							<wb-config wb-plugin="wb-doaction">
								<wb-config source="#dsa11y" action="patch" cumulative="true">
									<wb-config wb-prop="patches">
										<wb-config data-btn-remove op="remove" path="/earl:subject/oa:hasState/[[-id-]]"></wb-config>
									</wb-config>
								</wb-config>
							</wb-config>
						</button>
					</li>
				</template>
			</ul>

			<fieldset id="addSubjectHasState" data-path="/earl:subject/oa:hasState/-" data-template-object='{ "@type": "acr:MediaQueryList" }' data-independent-input>
				<label>Media query:
					<select id="abc" data-path="/acr:stateValue" data-clean-on-import data-independent-input>
						<option value="(max-width: 479px)">Extra extra small (max-width: 479px)</option>
						<option value="(min-width: 480px) and (max-width: 767px)">Extra small (min-width: 480px) and (max-width: 767px)</option>
						<option value="(min-width: 768px) and (max-width: 991px)">Small (min-width: 768px) and (max-width: 991px)</option>
						<option value="(min-width: 992px) and (max-width: 1199px)">Medium (min-width: 992px) and (max-width: 1199px)</option>
						<option value="(min-width: 1200px) and (max-width: 1599px)">Large (min-width: 1200px) and (max-width: 1599px)</option>
						<option value="(min-width: 1600px)">Extra large (min-width: 1600px)</option>
					</select>
				</label>
				<button type="button" data-wb-doaction>
					Add

					<wb-config wb-plugin="wb-doaction">

						<wb-config source="#dsa11y" action="importInDataset" cumulative="true" inputs="#addSubjectHasState, #abc"></wb-config>

					</wb-config>
				</button>
			</fieldset>

			<fieldset id="addSubjectHasCSSState" data-path="/earl:subject/oa:hasState/-" data-template-object='{ "@type": "oa:CssSelector" }' data-independent-input>
				<label>State known by CSS selector:
					<select id="abc-addSubjectHasCSSState" data-path="/acr:stateValue" data-clean-on-import data-independent-input>
						<option value="[dir=rtl]">Right to left text direction</option>
					</select>
				</label>
				<button type="button" data-wb-doaction>
					Add

					<wb-config wb-plugin="wb-doaction">

						<wb-config source="#dsa11y" action="importInDataset" cumulative="true" inputs="#addSubjectHasCSSState, #abc-addSubjectHasCSSState"></wb-config>

					</wb-config>
				</button>
			</fieldset>
		</div>
		<div class="col-md-12">
			<label class="full-width">Applicability (Short description of what is being assessed): <input class="full-width" type="text" data-path="/earl:subject/dct:description"></label>
		</div>
		<div class="col-md-12">
			<label>CSS Selector: <input type="text" data-path="/earl:subject/earl:pointer/@value"> (ex: <code>title, meta, main</code>; <code>main *:not(.pagedetails *, .pagedetails)</code>)</label>
		</div>
	</div>
</fieldset>

<h2>Assessor</h2>

<div data-wb-json='{
	"url": "#[a11y]/earl:assertedBy",
	"streamline": true,
	"mapping": [
		{
			"@type": "rdf:Alt",
			"comment": "this ALT is needed because when earl:assertedBy is null, there is 2 condition that is applicable and we only want the first one to be executed",
			"mapping": [
				{
					"template": "[data-no-assertor]",
					"test": "fn:guessType",
					"assess": "/",
					"expect": "undefined",
					"mapping": null
				},
				{
					"template": "[data-main-assertor]",
					"test": "fn:guessType",
					"assess": "/",
					"expect": "foaf:Organization",
					"mapping": [
						{
							"selector": "[data-main]",
							"value": "/earl:mainAssertor/foaf:homepage",
							"type": "attr",
							"attr": "href"
						},
						{
							"selector": "[data-main]",
							"value": "/earl:mainAssertor/foaf:name",
							"type": "replace"
						},
						{
							"selector": "[data-assertor]",
							"value": "/foaf:homepage",
							"type": "attr",
							"attr": "href"
						},
						{
							"selector": "[data-assertor]",
							"value": "/foaf:name",
							"type": "replace"
						},
						{
							"template": "[data-main-assisted]",
							"test": "fn:guessType",
							"value": "/foaf:member",
							"assess": "/",
							"dev_debug_note": "We should not also define the assess here, but somehow the value if navigated before the actual test",
							"expect": "earl:Software",
							"mapping": [
								{
									"selector": "[data-name]",
									"value": "/doap:name"
								},
								{
									"selector": "[data-homepage]",
									"value": "/doap:homepage"
								},
								{
									"selector": "[data-repository]",
									"value": "/doap:repository"
								},
								{
									"selector": "[data-created]",
									"value": "/doap:created"
								},
								{
									"selector": "[data-release]",
									"value": "/doap:release"
								}
							]
						}
					]
				},
				{
					"template": "[data-assertor]",
					"test": "fn:guessType",
					"assess": "/",
					"expect": "foaf:Person",
					"mapping": [
						{
							"selector": "[data-assertor]",
							"value": "/foaf:homepage",
							"type": "attr",
							"attr": "href"
						},
						{
							"selector": "[data-assertor]",
							"value": "/foaf:name",
							"type": "replace"
						},
						{
							"template": "[data-assertor-assisted]",
							"test": "fn:guessType",
							"assess": "/",
							"dev_debug_note": "See the other debug note",
							"value": "/foaf:member",
							"expect": "earl:Software",
							"mapping": [
								{
									"selector": "[data-name]",
									"value": "/doap:name"
								},
								{
									"selector": "[data-homepage]",
									"value": "/doap:homepage"
								},
								{
									"selector": "[data-repository]",
									"value": "/doap:repository"
								},
								{
									"selector": "[data-created]",
									"value": "/doap:created"
								},
								{
									"selector": "[data-release]",
									"value": "/doap:release"
								}
							]
						}
					]
				}
			]
		}

	],
	"removeAll": "p, dl"
}'>
	<template data-main-assertor>
		<p><a data-main href="#">Unknown</a> on behalf of <a data-assertor href="#">Not Available</a></p>
		<template data-main-assisted>
			<p>With the software assistance:</p>
			<dl>
				<dt>Product name:</dt>
				<dd data-name></dd>
				<dt>Homepage:</dt>
				<dd data-homepage></dd>
				<dt>Repository URL:</dt>
				<dd data-repository></dd>
				<dt>Was released/installed on:</dt>
				<dd data-created></dd>
				<dt>Software version:</dt>
				<dd data-release></dd>
			</dl>
		</template>
	</template>
	<template data-assertor>
		<p><a data-assertor href="#">Unknown</a></p>
		<template data-assertor-assisted>
			<p>With the software assistance:</p>
			<dl>
				<dt>Product name:</dt>
				<dd data-name></dd>
				<dt>Homepage:</dt>
				<dd data-homepage></dd>
				<dt>Repository URL:</dt>
				<dd data-repository></dd>
				<dt>Was released/installed on:</dt>
				<dd data-created></dd>
				<dt>Software version:</dt>
				<dd data-release></dd>
			</dl>
		</template>
	</template>
	<template data-no-assertor>
		<p>There is no assessor currently defined</p>
	</template>
</div>

<details>
