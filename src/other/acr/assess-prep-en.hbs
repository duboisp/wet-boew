	<fieldset id="assertedByOrg" data-path="/earl:assertedBy" data-template-object='{ "@type": ["earl:Assertor","foaf:Organization"], "earl:mainAssertor": { "@type": ["earl:Assertor","foaf:Person"] } }' data-independent-input>
