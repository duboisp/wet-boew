---
{
	"title": "Accessibility Conformance Report Methodology",
	"language": "en",
	"category": "Other",
	"description": "",
	"tag": "acr",
	"parentdir": "acr",
	"altLangPage": "assess-prep-fr.html",
	"dateModified": "2023-05-09",
	"js-deactivated": ["demo/load"]
}
---


<div id="existing-assessment" data-wb-jsonmanager='{
		"load": "local",
		"name": "existing-assessment",
		"savename": "a11y-assess"
	}'></div>

<div data-wb-json='{
	"url": "#[existing-assessment]",
	"streamline": true,
	"template": "[data-tmpl]",
	"mapping": null
}'>
	<template data-tmpl>
		<div class="alert alert-warning">
			<p>There is already an assessment in progress, uploading one or creating a new are going to replace it.</p>
			<p><a href="assess-prep-en.html">Continue the current assessment</a></p>
		</div>
	</template>

</div>

<div class="row">

<div class="col-md-6">

<h2>Load an assessment</h2>

<!-- The button work like the action manager JSON load, but do a popup file upload -->
<button type="button" data-wb-doaction='[
	{ "action": "uploadJSON", "source": "#ds-a11y", "asDataset": "[uploaded]" }

]'>Upload and load</button>




<div id="ds-a11y" data-wb-jsonmanager='{
	"url":"#[uploaded]",
	"name": "a11y",
	"savename": "a11y-assess"
}'></div>

<div data-wb-json='{
	"url": "#[a11y]",
	"streamline": true,
	"fail": {
		"template": "[data-fail]",
		"removeAll": "div",
		"mapping": null
	},
	"removeAll": "div",
	"template": "[data-tmpl]",
	"mapping": [
		{
			"template": "[data-bad]",
			"test": "fn:guessType",
			"expect": "acr:AssessmentReport",
			"operand": "neq",
			"mapping": null
		},
		{
			"template": "[data-good]",
			"test": "fn:guessType",
			"expect": "acr:AssessmentReport",
			"mapping": [
				{ "selector": "[data-description]", "value": "/dct:description" }
			]
		}
	]
}'>
	<template data-fail>
		<div class="alert alert-danger">
			<p>The select file for upload is an invalid JSON file, please select a valid JSON file.</p>
		</div>
	</template>
	<template data-tmpl>
		<template data-bad>
			<div>
				<p>Please upload a valid ACR assessment file.</p>
			</div>
		</template>
		<template data-good>
			<div>
				<p>Your uploaded file seem ok.</p>
				<dl class="dl-horizontal">
					<!--
					<dt>Assessment language:</dt><dd data-lang>Undefined</span></dd>
					<dt>Assessment title:</dt><dd data-title></span></dd>
					-->
					<dt>Description:</dt><dd data-description></span></dd>
				</dl>
				<a class="btn btn-primary" href="assess-prep-en.html" data-wb-doaction>
					Edit and continue your assessment

					<wb-config wb-plugin="wb-doaction">
						<wb-config source="#ds-a11y" action="saveDataSet" mode="local"></wb-config>
					</wb-config>

				</a>
			</div>
		</template>
	</template>
</div>




</div>

<div class="col-md-6">

<h2>Create a new assessment</h2>

<!-- Eventually, let's use fieldflow to reveal the profile available for the choosen standard -->
<!-- To select correctly the right ruleset, we should have a way to query data based on two condition, the standard and the profile, instead of only relying on the profile -->

<div id="ds-new" data-wb-jsonmanager='{
	"name": "new",
	"savename": "a11y-assess"
}'></div>

<label>
	Choose a standard:
	<select data-new data-path="/acr:standard">
		<option value="https://www.w3.org/TR/WCAG21">WCAG</option>
		<option value="https://www.etsi.org/deliver/etsi_en/301500_301599/301549/03.02.01_60/en_301549v030201p.pdf">EN 301 549 v3</option>
	</select>
</label>

<br>

<label>
	Choose the conformance option:
	<select data-new data-path="/acr:conformanceOption">
		<option value="act:standard/profiles/wcag#levelAA">Level AA</option>
		<option value="rulesetsact:standard/profiles/wcag#delta21_levelAA">Delta WCAG 2.1 Level AA</option>
		<option value="act:standard/profiles/en301549#ictClauseFunc">5.1. Clause functionality</option>
		<option value="act:standard/profiles/en301549#ictTwoVoiceComm">6. ICT with two-way voice communication</option>
		<option value="act:standard/profiles/en301549#ictVideo">7. ICT with video capabilities</option>
		<option value="act:standard/profiles/en301549#hardware">8. Hardware</option>
		<option value="act:standard/profiles/en301549#web">9. Web</option>
		<option value="act:standard/profiles/en301549#nonWeb">10. Non-web documents</option>
		<option value="act:standard/profiles/en301549#software">11. Software</option>
		<option value="act:standard/profiles/en301549#supportServices">12.2. Support services </option>
		<option value="act:standard/profiles/en301549#relayServices">13.1. and 13.2 Relay services</option>
		<option value="act:standard/profiles/en301549#twoWayCommEmergencyServices">13.3. Two way communication emergency services</option>
	</select>
</label>

<br>

<a class="btn btn-primary" href="assess-prep-en.html" data-wb-doaction>
	Start a new assessment

	<wb-config wb-plugin="wb-doaction">

		<!-- Prep the assessment -->
		<wb-config source="#ds-new" action="patch" action-name="prepData" cumulative="true" passive="true">
			<wb-config wb-prop="patches">
				<wb-config op="add" path="/@context" value="https://wet-boew.github.io/vocab/context/2023/assessment-report-en.json-ld"></wb-config>
				<wb-config op="add" path="/@type">
					<wb-config wb-prop="value" wb-value='[ "earl:Assertion", "acr:AssessmentReport" ]'></wb-config>
				</wb-config>
				<wb-config op="add" path="/dct:date">
					<wb-config wb-prop="value" wb-value='null'></wb-config>
				</wb-config>
				<wb-config op="add" path="/dct:description" value="About this assessment and any summary notes."></wb-config>
				<wb-config op="add" path="/earl:result">
					<wb-config wb-prop="value" wb-value='[]'></wb-config>
				</wb-config>
			</wb-config>
		</wb-config>

		<!-- Import the standard + conformance option -->
		<wb-config source="#ds-new" action="importInDataset" action-name="importData" run-after="prepData" cumulative="true" inputs="select[data-new]"></wb-config>

		<!-- Save it in the local storage -->
		<wb-config source="#ds-new" action="saveDataSet" run-after="importData" mode="local"></wb-config>
	</wb-config>
</a>

</div>
</div>
