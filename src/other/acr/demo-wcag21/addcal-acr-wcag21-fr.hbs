			"url": "#[a11y]/acr:conformityCriteria",
			"tobeclone": "tr",
			"source": "#tmpl-requirements",
			"mapping": [
				{ "selector": "[data-requirement-label]", "value": "/acr:requirement" },
				{ "selector": "[data-conformance]", "value": "/acr:conformance" },
				{ "selector": "[data-notes]", "value": "/notes" },
				{ "selector": "[data-mode]", "value": "/earl:mode" },
				{
					"selector": "[data-assessment]",
					"value": "/acr:assessment",
					"mapping": [
						{ "selector": "[lang]", "value": "/dct:language", "attr": "lang" },
						{ "selector": "a", "value": "/dct:title" },
						{ "selector": "a", "value": "/dct:references", "attr": "href" },
						{ "selector": "time", "value": "/dct:date" }
					]
				}
			]
		}'>
		</tbody>
	</table>

	<template id="tmpl-requirements">
		<table>
			<tr>
				<th data-requirement-label></th>
				<td><span data-conformance></span></td>
				<td>
					<dl class="dl-horizontal">
						<dt>Mode de vérification:</dt>
						<dd data-mode></dd>
						<dt>Notes:</dt>
						<dd data-notes lang="en"></dd>
					</dl>
					<details>
						<summary>Évaluation associé</summary>
							<ul class="list-unstyled" data-assessment>
								<template>
									<li lang><time></time> - <a href></a></li>
								</template>
							</ul>
					</details>
				</td>
			</tr>
		</table>
	</template>

</section>
