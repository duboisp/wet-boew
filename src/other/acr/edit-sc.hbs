<div data-wb-json='{
	"url": "#[edit-sc]",
	"template": "[data-save-btn]",
	"streamline": true,
	"mapping": [
		{ "selector": "[data-workspace-id-rem]", "value": "/workspace-id", "attr": "path", "placeholder": "[[-id-]]" },
		{ "selector": "[data-workspace-id]", "value": "/workspace-id", "attr": "path", "placeholder": "[[-id-]]" }
	],
	"removeAll": "a"
}'>
	<template data-save-btn>
		<a class="btn btn-lg btn-primary" href="assess-prep-en.html#assessment-details" data-wb-doaction>
			<wb-config wb-plugin="wb-doaction">
				<wb-config source="#myDataSet" action="importInDataset" cumulative="true" passive="true"></wb-config>
				<wb-config source="#myDataSet" action="patch" cumulative="true" passive="true">
					<wb-config wb-prop="patches">
						<wb-config data-workspace-id-rem op="remove" path="/earl:result/[[-id-]]"></wb-config>
						<wb-config data-workspace-id op="move" path="/earl:result/[[-id-]]" from="/workspace"></wb-config>
						<wb-config op="remove" path="/workspace"></wb-config>
					</wb-config>
				</wb-config>
				<wb-config source="#myDataSet" action="saveDataSet" mode="local"></wb-config>
			</wb-config>

			Save and return
		</a>
	</template>
</div>
