<p class=h1>Git reset to: <code>origin/assessment-form2</code></p>


<ol>
	<li>Load from the local storage the dataset</li>
	<li>Get the ID saved + Load value into the web interface</li>
	<li>Edit the form</li>
	<li>Validate the form</li>
	<li>Save the SC edited information, save it and return to the main page</li>
	<li>TODO: An edit-sc is only applicable to one "subject", either it is the global one or either it is a specifity of it. That say, this test + all sub-test should be updated to contain the @id of the tested subject</li>
</ol>
<form>
<details>
	<summary>JSON Manager debug</summary>

	<div data-wb-jsonmanager-proposed='{
		"url": { "url": "#[uploaded]", load-from: "local-storage | session | data-layer", "load-key": "localStorage KEY", "Select path" },
		"name": "edit-sc"
	}'></div>

	<div data-wb-jsonmanager-out='{
		"url": [ { "url": "demo-wcag21/assessment-wcag21-SC1_1_1-a.json" } ],
		"name": "full-ds",
		"debug": true
	}'>
	<!-- {
		"url": [ { "url": "demo-wcag21/assessment-wcag21-SC1_1_1-a.json" } ],
		"name": "full-ds",
		"patches": [
			{ "op": "patches", "path": "/earl:result", "patches": [
					{ "op": "wb-swap", "path": "/earl:subject", "ref": "/earl:subject" }
				]
			}
		],
		"debug": true
	} -->
	</div>

	<!-- If load from localhost fail, throw a fetch error state
	<div id="myDataSet" data-wb-jsonmanager='{
		"load": "local",
		"name": "edit-sc",
		"debug": true
	}'></div>
	 -->

	<div id="myDataSet" data-wb-jsonmanager='{
		"url2": "demo-wcag21/assessment-wcag21-SC1_1_1-a.json#/earl:result/0",
		"url": "demo/workingspace-data.json",
		"name": "edit-sc",
		"patches": [
			{ "op": "wb-swap", "path": "/workspace/earl:test", "ref": "/sc-rulesets", "put": "/sc-rulesets", "comment_value": "_value_ is a selector from where to take the value from the _ref_ which would be replaced at the specified _path_ location" }
		],
		"debug": true
	}'></div>

	<div id="pre-views-layer" data-wb-jsonmanager='{
		"url": "#[edit-sc]",
		"name": "pre-views-sc",
		"patches": [
			{ "op": "wb-swap", "path": "/workspace/earl:subject", "ref": "/earl:subject" }
		],
		"debug": true
	}'></div>

	<div id="views-layer" data-wb-jsonmanager='{
		"url": [
			"#[pre-views-sc]/workspace",
			"demo-wcag21/labels.json"
		],
		"name": "present-sc",
		"patches": [
			{ "op": "wb-swap", "path": "/earl:test", "ref": "/labels/earl:TestCriterion/en" },
			{ "op": "patches", "path": "/earl:result",
				"patches": [
					{ "op": "wb-swap", "path": "/earl:test", "ref": "/labels/earl:TestCriterion/en", "put": "/dct:title" }
				]
			}
		],
		"debug": true
	}'></div>

</details>

<p data-json-replace="#[present-sc]/earl:mode">earl:test</p>

<dl>
	<dt>Success criterion</dt>
	<dd data-json-replace="#[present-sc]/earl:test">earl:test</dd>
	<dt>Subject</dt>
	<dd data-json-replace="#[present-sc]/earl:subject/dct:description">dct:references OR dct:title of _:subject</dd>
</dl>

<div class="row">
<div class="col-md-4">

<div class="form-group">
	<label for="f-mode">Testing mode</label>
	<select id="f-mode" class="form-control" name="/workspace/earl:mode" data-wb-json='{ "url":"#[edit-sc]/workspace/earl:mode", "type": "select" }'>
		<option value="earl:automatic">Automatic</option>
		<option value="earl:manual">Manual</option>
		<option value="earl:semiAuto">Semi-Automatic</option>
		<option value="earl:undisclosed">Undisclosed</option>
		<option value="earl:unknownMode">Unknown</option>
	</select>
</div>

</div>
<div class="col-md-4">
<div class="form-group">
	<label for="f-severity">Severity</label>
	<select id="f-severity" class="form-control" name="/workspace/acr:severity" data-wb-json='{ "url":"#[edit-sc]/workspace/acr:severity", "type": "select" }'>
		<option value="acr:noSeverity">Not specified</option>
		<option value="acr:forEvaluation">Need to be evaluated</option>
		<option value="acr:notRelevant">Not relevant to specify severity</option>
		<option value="acr:critical">Critical</option>
		<option value="acr:serious">Serious</option>
		<option value="acr:moderate">Moderate</option>
		<option value="acr:trivial">Trivial</option>
	</select>
</div>

</div>
<div class="col-md-4">
<div class="form-group">
	<label for="f-relevancy">Relevancy</label>
	<select id="f-relevancy" class="form-control" name="/workspace/acr:relevancy" data-wb-json='{ "url":"#[edit-sc]/workspace/acr:relevancy", "type": "select" }'>
		<option value="wbv:acr#noRelevancy">Not specified</option>
		<option value="acr:forEvaluation">Need to be evaluated</option>
		<option value="acr:notRelevant">Not relevant to specify relevancy</option>
		<option value="acr:sufficient">Sufficient</option>
		<option value="acr:advisory">Advisory</option>
		<option value="acr:statement">Statement</option>
		<option value="acr:failure">Failure</option>
		<option value="acr:compatibility">Compatibility</option>
		<option value="acr:usability">Usability</option>
		<option value="acr:expertise">Expertise</option>
		<option value="acr:opinionated">Opinionated</option>
		<option value="acr:comments">Comments</option>
	</select>
</div>
</div>
</div>

<div class="form-group">
	<label for="f-description">Description</label>
	<!--<input type="text" class="form-control" id="f-description" name="/workspace/dct:description" data-wb-json='{ "url":"#[edit-sc]/workspace/dct:description", "type": "val" }' />-->
	<textarea id="f-description" class="form-control full-width" rows="5" name="/workspace/dct:description" data-wb-json='{ "url":"#[edit-sc]/workspace/dct:description", "type": "val" }'></textarea>
</div>

<!-- TODO: Use a data attribute for the name if we don't want this field to be submitted -->
<fieldset>
	<legend>Test outcome</legend>
	<ul class="list-unstyled" data-wb-json='{ "url":"#[edit-sc]/workspace/earl:outcome", "type": "select" }'>
		<li class="radio-inline"><label><input type="radio" name="/workspace/earl:outcome" value="earl:untested"> Untested</label></li>
		<li class="radio-inline"><label><input type="radio" name="/workspace/earl:outcome" value="earl:passed"> Passed</label></li>
		<li class="radio-inline"><label><input type="radio" name="/workspace/earl:outcome" value="earl:failed"> Failed</label></li>
		<li class="radio-inline"><label><input type="radio" name="/workspace/earl:outcome" value="earl:cantTell"> Cannot tell</label></li>
		<li class="radio-inline"><label><input type="radio" name="/workspace/earl:outcome" value="earl:inapplicable"/> Inapplicable</label></li>
	</ul>
</fieldset>


