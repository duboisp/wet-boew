<h2 id="attachement">Associated assets and attachment (/acr:asset)</h2>

<details>
	<summary>Add images</summary>

	<fieldset id="fs-add-images">
		<legend>Add an image</legend>

		<label>Image: <input type="file" name="/workspace-asset/acr:content/@value" accept="image/*" data-clean-on-import data-independent-input /></label> <br />

		<label>Title: <input type="text" name="/workspace-asset/dct:title" data-clean-on-import data-independent-input /></label>


		<button type="button" data-wb-doaction>
			Add

			<wb-config wb-plugin="wb-doaction">
				<wb-config source="#myDataSet" action="patch" action-name="prepData" cumulative="true">
					<wb-config wb-prop="patches">
						<wb-config op="remove" path="/workspace-asset"></wb-config>
						<wb-config op="add" path="/workspace-asset">
							<wb-config wb-prop="value" wb-value='{ "@type": "acr:AttachmentImage", "acr:content": { "@type": "xsd:anyURI" } }'></wb-config>
						</wb-config>
					</wb-config>
				</wb-config>

				<wb-config source="#myDataSet" action="importInDataset" action-name="getinputs"  run-after="prepData" cumulative="true" inputs="#fs-add-images input"></wb-config>

				<wb-config source="#myDataSet" action="patch" run-after="getinputs" cumulative="true">
					<wb-config wb-prop="patches">
						<wb-config op="wb-add-from" value="/workspace-asset" path="/workspace/acr:asset/-">
						</wb-config>
					</wb-config>
				</wb-config>

			</wb-config>
		</button>
	</fieldset>
</details>

<details>
	<summary>Add a JSON content</summary>
<fieldset>
	<legend>Add a JSON content</legend>

	<div id="fs-add-upload-json">
		<label>Upload a JSON file:

				<input type="file" name="/workspace-asset/@value" data-encode="json" accept="application/json application/ld+json" data-clean-on-import data-independent-input />

		</label>

		<button type="button" data-wb-doaction>
			Upload and add the JSON file

			<wb-config wb-plugin="wb-doaction">

					<wb-config source="#myDataSet" action="patch" action-name="prepData" cumulative="true">
						<wb-config wb-prop="patches">
							<wb-config op="remove" path="/workspace-asset"></wb-config>
							<wb-config op="add" path="/workspace-asset">
								<wb-config wb-prop="value" wb-value='{ "@type": "@json" }'></wb-config>
							</wb-config>
						</wb-config>
					</wb-config>

					<wb-config source="#myDataSet" action="importInDataset" action-name="getinputs" run-after="prepData" cumulative="true" inputs="#fs-add-upload-json input"></wb-config>

					<wb-config source="#myDataSet" action="patch" run-after="getinputs" cumulative="true">
						<wb-config wb-prop="patches">
							<wb-config op="wb-add-from" value="/workspace-asset" path="/workspace/acr:asset/-">
							</wb-config>
						</wb-config>
					</wb-config>
			</wb-config>
		</button>
	</div>

	<hr />

	<div id="fs-add-json-text">

		<label class="full-width">Insert JSON content:<br /><textarea class="full-width" name="/workspace-asset/@value" data-encode="json" rows="7" data-clean-on-import data-independent-input></textarea></label>

		<button id="addButton" type="button" data-wb-doaction>
			Insert the JSON content

			<wb-config wb-plugin="wb-doaction">

					<wb-config source="#myDataSet" action="patch" action-name="prepData" cumulative="true">
						<wb-config wb-prop="patches">
							<wb-config op="remove" path="/workspace-asset"></wb-config>
							<wb-config op="add" path="/workspace-asset">
								<wb-config wb-prop="value" wb-value='{ "@type": "@json" }'></wb-config>
							</wb-config>
						</wb-config>
					</wb-config>

					<wb-config source="#myDataSet" action="importInDataset" action-name="getinputs"  run-after="prepData" cumulative="true" inputs="#fs-add-json-text textarea"></wb-config>

					<wb-config source="#myDataSet" action="patch" run-after="getinputs" cumulative="true">
						<wb-config wb-prop="patches">
							<wb-config op="wb-add-from" value="/workspace-asset" path="/workspace/acr:asset/-">
							</wb-config>
						</wb-config>
					</wb-config>

				</wb-config>
		</button>
	</div>

</fieldset>

</details>


<details>
	<summary>Add a link/reference</summary>

	<!-- This link importer do work as expected -->
	<fieldset id="fs-add-ref">
		<legend>Add a link/a reference</legend>

		<input type="url" name="/workspace-asset/@value" data-clean-on-import data-independent-input />

		<button id="addButton" type="button" data-wb-doaction>
			Add

			<wb-config wb-plugin="wb-doaction">

				<wb-config source="#myDataSet" action="patch" action-name="prepData" cumulative="true">
					<wb-config wb-prop="patches">
						<wb-config op="remove" path="/workspace-asset"></wb-config>
						<wb-config op="add" path="/workspace-asset">
							<wb-config wb-prop="value" wb-value='{ "@type": "xsd:anyURI" }'></wb-config>
						</wb-config>
					</wb-config>
				</wb-config>

				<wb-config source="#myDataSet" action="importInDataset" run-after="prepData" cumulative="true" inputs="#fs-add-ref input"></wb-config>
				<wb-config source="#myDataSet" action="patch" run-after="prepData" cumulative="true">
					<wb-config wb-prop="patches">
						<wb-config op="add" path="/workspace-asset/@type" value="xsd:anyURI"></wb-config>
						<wb-config op="wb-add-from" value="/workspace-asset" path="/workspace/acr:asset/-">
						</wb-config>
					</wb-config>
				</wb-config>
			</wb-config>
		</button>
	</fieldset>
</details>

<details>
	<summary>Add a code sample</summary>

	<fieldset id="fs-add-codesample">
