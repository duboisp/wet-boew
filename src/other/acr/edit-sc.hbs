	<div id="myDataSet" data-wb-jsonmanager='{
		"load": "local",
		"savename": "a11y-assess",
		"name": "edit-sc",
		"patches": [
			{ "op": "if", "path": "/workspace/earl:result", "test": "typeof", "value": "undefined", "patches": [
					{ "op": "add", "path": "/workspace/earl:result", "value": [] }
				]
			},
			{ "op": "if", "path": "/workspace/acr:asset", "test": "typeof", "value": "undefined", "patches": [
					{ "op": "add", "path": "/workspace/acr:asset", "value": [] }
				]
			},
			{ "op": "wb-swap", "path": "/workspace/earl:test", "ref": "/sc-rulesets", "put": "/sc-rulesets", "comment_value": "_value_ is a selector from where to take the value from the _ref_ which would be replaced at the specified _path_ location" }
		],
