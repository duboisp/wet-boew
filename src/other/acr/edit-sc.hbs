			</figure>
			<button type="button" data-wb-doaction>
				Remove

				<wb-config wb-plugin="wb-doaction">
					<wb-config source="#lst-assets" action="setFocus"></wb-config>
					<wb-config source="#myDataSet" action="patch" cumulative="true">
						<wb-config wb-prop="patches">
							<wb-config data-btn-remove op="remove" path="/workspace/acr:asset/[[-id-]]"></wb-config>
						</wb-config>
					</wb-config>
				</wb-config>
			</button>
		</li>
	</template>
</ul>


<h2 id="sub-tests">Short sub-test (/earl:result)</h2>

<button id="addButton" type="button" data-wb-doaction>
	Add a detailed test result

	<wb-config wb-plugin="wb-doaction">
		<wb-config source="#myDataSet" action="importInDataset" cumulative="true"></wb-config>
		<wb-config source="#myDataSet" action="patch" cumulative="true">
			<wb-config wb-prop="patches">
				<wb-config op="add" path="/workspace/earl:result/-">
					<wb-config wb-prop="value" wb-value='{
						"earl:test": "Enter the URL of the test or technique",
						"earl:outcome": "earl:untested",
						"earl:subject": "_:subject"
					}'></wb-config>
				</wb-config>
			</wb-config>
		</wb-config>
	</wb-config>
</button>

