					<wb-config source="#myDataSet" action="patch" cumulative="true">
						<wb-config wb-prop="patches">
							<wb-config data-btn-remove op="remove" path="/workspace/earl:result/[[-id-]]"></wb-config>
						</wb-config>
					</wb-config>
				</wb-config>
			</button>

		</td>
	</tr></table>
