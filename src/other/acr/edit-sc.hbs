<button class="btn btn-lg btn-primary" type="button" data-wb-doaction>
	<wb-config wb-plugin="wb-doaction">
		<wb-config source="#myDataSet" action="importInDataset" cumulative="true"></wb-config>
		<wb-config source="#myDataSet" action="saveDataSet" mode="local"></wb-config>
	</wb-config>

	Save and return
</button>

<button class="btn btn-link" type="button" data-wb-doaction>
	<!-- This button is updated with data-json from the information in the workspace -->
	<template>
		<wb-config action="patch, move to it's main index"></wb-config>
		<!-- <wb-config empty the workspace -->
		<!-- Save the dataset -->
		<!-- Redirect to the main page or form post submit to main page -->
	</template>
	<wb-config wb-plugin="wb-doaction">
		<wb-config source="#myDataSet" action="importInDataset" cumulative="true"></wb-config>
		<wb-config source="#myDataSet" action="saveDataSet" mode="download"></wb-config>
	</wb-config>

	Download
</button>


