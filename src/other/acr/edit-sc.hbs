		</button>
	</fieldset>

</details>

<details>
	<summary>Embed a resource (type image)</summary>

	<!-- This file importer do work as expected -->
	<fieldset id="fs-add-ressource">
		<legend>Embed a resource</legend>

		<input type="file" name="/workspace-asset/@value" accept="image/* application/*" data-clean-on-import data-independent-input />

		<button id="addButton" type="button" data-wb-doaction>
			Add

			<wb-config wb-plugin="wb-doaction">

				<wb-config source="#myDataSet" action="patch" action-name="prepData" cumulative="true">
					<wb-config wb-prop="patches">
						<wb-config op="remove" path="/workspace-asset"></wb-config>
