<!-- This suggestion is build based on the test evaluation on this page -->
<label>Suggestion of rulesets
<select id="suggest-rulesets" name="/workspace-rulesets/selected"  data-wb-json='
	{
		"url": "#[pre-views-sc]/sc-rulesets",
		"mapping": [
			{ "selector": "option", "value": "/dct:title" },
			{ "selector": "option", "attr": "value", "value": "/@id" }
		],
		"removeAll": "option"
	}
'>
	<template>
		<option></option>
	</template>
</select>
</label>

<button type="button" data-wb-doaction>
	Import a set of sub-tests

	<!--
		1. Grab the selected option in the previous select
		2. Copy the "rules" into a working space
		3. Complement each "rules" with the other info we have
	-->

	<wb-config wb-plugin="wb-doaction">

				<!-- Clean the workspace -->
				<wb-config source="#myDataSet" action="patch" action-name="prepData" cumulative="true" passive="true">
					<wb-config wb-prop="patches">
						<wb-config op="remove" path="/workspace-rulesets"></wb-config>
						<wb-config op="add" path="/workspace-rulesets">
							<wb-config wb-prop="value" wb-value='{ "rulesets": [] }'></wb-config>
						</wb-config>
					</wb-config>
				</wb-config>

				<!-- Get the form input -->
				<wb-config source="#myDataSet" action="importInDataset" action-name="getinputs" run-after="prepData" cumulative="true" inputs="#suggest-rulesets"></wb-config>

				<!-- Create a working copy -->
				<wb-config source="#myDataSet" action="patch" cumulative="true" run-after="getinputs">
					<wb-config wb-prop="patches">
						<wb-config op="copy" from="/sc-rulesets" path="/workspace-rulesets/rulesets"></wb-config>

				<!-- Select the value -->
					<wb-config op="wb-swap" path="/workspace-rulesets/selected" ref="/workspace-rulesets/rulesets"></wb-config>

				<!-- Copy the rule -->
					<wb-config op="wb-add-from" value="/workspace-rulesets/selected/rules" path="/workspace/earl:result/-"></wb-config>

					</wb-config>
				</wb-config>
				<!--<wb-config op="copy" from="/sc-rulesets/WCAG21:non-text-content/rulesets/act:rulesets/wcag2x/sc/non-text-content#situations">
					<wb-config wb-prop="value" wb-value='{
						"earl:test": "Enter the URL of the test or technique",
						"earl:outcome": "earl:untested",
						"earl:subject": "_:subject"
					}'></wb-config>
				</wb-config>-->

	</wb-config>

	<!--

	<wb-config op="wb-add-from" value="/workspace-asset" path="/workspace/acr:asset/-">
						</wb-config>

	<wb-config wb-plugin="wb-doaction">
		<wb-config source="#myDataSet" action="importInDataset" cumulative="true"></wb-config>
		<wb-config source="#myDataSet" action="patch" cumulative="true">
			<wb-config wb-prop="patches">
				<wb-config op="add" path="/workspace/earl:result/-">
					<wb-config wb-prop="value" wb-value='{
						"earl:test": "Enter the URL of the test or technique",
						"earl:outcome": "earl:untested",
						"earl:subject": "_:subject"
					}'></wb-config>
				</wb-config>
			</wb-config>
		</wb-config>
	</wb-config>
	-->
</button>





<table class="table">
	<thead>
		<tr>
			<th id="sub-test-test">Test (URL)</th>
			<th id="sub-test-outcome">Outcome</th>
			<th id="sub-test-severity">Severity</th>
			<th id="sub-test-relevancy">Relevancy</th>
			<th id="sub-test-notes">Notes</th>
		</tr>
	</thead>
	<tbody data-wb-json='{
			"url": "#[present-sc]/earl:result",
			"tobeclone": "tr",
			"source": "#tmplSubTest",
			"mapping": [
				{ "selector": "[data-test-name]", "value": "/earl:test" },
				{ "selector": "[data-test-name]", "value": "/dct:title" },
				{ "selector": "[data-test]", "value": "/earl:test", "attr": "value" },
				{ "selector": "[data-test]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-btn-remove]", "value": "/_:iterator", "attr": "path", "placeholder": "[[-id-]]" },

				{ "selector": "[data-outcome]", "value": "/earl:outcome", "type": "select" },
				{ "selector": "[data-outcome]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },


				{ "selector": "[data-severity]", "value": "/earl:severity", "type": "select" },
				{ "selector": "[data-severity]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-relevancy]", "value": "/earl:relevancy", "type": "select" },
				{ "selector": "[data-relevancy]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-notes]", "value": "/dct:description", "attr": "value" },
				{ "selector": "[data-notes]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" }
			],
			"removeAll": "tr"
		}'>
	</tbody>
</table>

<template id="tmplSubTest">
	<table><tr>
		<!-- test ID -->
		<td>
			<p data-test-name>Unknown</p>
			<div class="form-group">
				<input data-test aria-labeledby="sub-test-test" type="url" class="form-control" name="/workspace/earl:result/[[-id-]]/earl:test" />
			</div>
			<button type="button" data-wb-doaction>
				Remove

				<wb-config wb-plugin="wb-doaction">
					<wb-config source="#sub-tests" action="setFocus"></wb-config>
					<wb-config source="#myDataSet" action="importInDataset" cumulative="true" passive="true"></wb-config>
					<wb-config source="#myDataSet" action="patch" cumulative="true">
						<wb-config wb-prop="patches">
							<wb-config data-btn-remove op="remove" path="/workspace/earl:result/[[-id-]]"></wb-config>
						</wb-config>
					</wb-config>
				</wb-config>
			</button>
		</td>

		<!-- outcome -->
		<td>



			<div class="form-group">
				<select data-outcome aria-labeledby="sub-test-outcome" class="form-control" name="/workspace/earl:result/[[-id-]]/earl:outcome">
					<option value="earl:untested">Untested</option>
					<option value="earl:passed">Passed </option>
					<option value="earl:failed">Failed </option>
					<option value="earl:cantTell">Cannot tell</option>
					<option value="earl:inapplicable">Inapplicable</option>
				</select>
			</div>
			<!--

				{ "selector": "[data-outcome-radio]", "value": "/earl:outcome", "type": "select" },
				{ "selector": "[data-a]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-b]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-c]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-d]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-e]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },

			<ul class="list-unstyled" data-outcome-radio>
				<li class="radio-inline"><label><input data-a type="radio" name="/workspace/earl:result/[[-id-]]/earl:outcome" value="earl:untested"> Untested</label></li>
				<li class="radio-inline"><label><input data-b type="radio" name="/workspace/earl:result/[[-id-]]/earl:outcome" value="earl:passed"> Passed</label></li>
				<li class="radio-inline"><label><input data-c type="radio" name="/workspace/earl:result/[[-id-]]/earl:outcome" value="earl:failed"> Failed</label></li>
				<li class="radio-inline"><label><input data-d type="radio" name="/workspace/earl:result/[[-id-]]/earl:outcome" value="earl:cantTell"> Cannot tell</label></li>
				<li class="radio-inline"><label><input data-e type="radio" name="/workspace/earl:result/[[-id-]]/earl:outcome" value="earl:inapplicable"/> Inapplicable</label></li>
			</ul>-->
		</td>

		<!-- Severity -->
		<td>
			<div class="form-group">
				<select data-severity aria-labeledby="sub-test-outcome" class="form-control" name="/workspace/earl:result/[[-id-]]/acr:severity">
					<option value="acr:noSeverity">Not specified</option>
					<option value="acr:forEvaluation">Need to be evaluated</option>
					<option value="acr:notRelevant">Not relevant to specify severity</option>
					<option value="acr:critical">Critical</option>
					<option value="acr:serious">Serious</option>
					<option value="acr:moderate">Moderate</option>
					<option value="acr:trivial">Trivial</option>
				</select>
			</div>
		</td>

		<!-- Relevancy -->
		<td>
			<div class="form-group">
				<select data-relevancy aria-labeledby="sub-test-relevancy" class="form-control" name="/workspace/earl:result/[[-id-]]/acr:relevancy">
					<option value="acr:noRelevancy">Not specified</option>
					<option value="acr:forEvaluation">Need to be evaluated</option>
					<option value="acr:notRelevant">Not relevant to specify relevancy</option>
					<option value="acr:sufficient">Sufficient</option>
					<option value="acr:advisory">Advisory</option>
					<option value="acr:statement">Statement</option>
					<option value="acr:failure">Failure</option>
					<option value="acr:compatibility">Compatibility</option>
					<option value="acr:usability">Usability</option>
					<option value="acr:expertise">Expertise</option>
					<option value="acr:opinionated">Opinionated</option>
					<option value="acr:comments">Comments</option>
				</select>
			</div>
		</td>

		<!-- Notes -->
		<td>
			<div class="form-group">
				<input data-notes aria-labeledby="sub-test-notes" type="text" class="form-control" name="/workspace/earl:result/[[-id-]]/dct:description" />
			</div>
		</td>
	</tr></table>
</template>


</form>



