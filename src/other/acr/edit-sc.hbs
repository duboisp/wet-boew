		<button id="addButton" type="button" data-wb-doaction>
			Add

			<wb-config wb-plugin="wb-doaction">

				<wb-config source="#myDataSet" action="patch" action-name="prepData" cumulative="true">
					<wb-config wb-prop="patches">
						<wb-config op="remove" path="/workspace-asset"></wb-config>
						<wb-config op="add" path="/workspace-asset">
