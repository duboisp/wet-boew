				</wb-config>

				<wb-config source="#myDataSet" action="importInDataset" action-name="getinputs"  run-after="prepData" cumulative="true" inputs="#fs-add-codesample input, #fs-add-codesample textarea"></wb-config>

				<wb-config source="#myDataSet" action="patch" run-after="getinputs" cumulative="true">
					<wb-config wb-prop="patches">
