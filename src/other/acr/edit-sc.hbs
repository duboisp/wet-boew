<h3 id="lst-assets">List of imported assets</h3>

<ul data-wb-json='{
	"url": "#[present-sc]/acr:asset",
	"mapping": [
		{
			"template": "[data-link]",
			"test": "fn:guessType",
			"value": "/",
			"expect": "xsd:anyURI",
			"append": true,
			"mapping": [
				{ "selector": "a", "value": "/@value" },
				{ "selector": "a", "value": "/@value", "attr": "href" },
				{ "selector": "[data-btn-remove]", "value": "/_:iterator", "attr": "path", "placeholder": "[[-id-]]" }
			],
			"debug": true
		},
		{
			"template": "[data-download-link]",
			"test": "fn:guessType",
			"value": "/",
			"expect": "https://www.rfc-editor.org/rfc/rfc2397#section-2",
			"append": true,
			"mapping": [
				{ "selector": "a", "value": "/@value", "attr": "href" },
				{ "selector": "[data-btn-remove]", "value": "/_:iterator", "attr": "path", "placeholder": "[[-id-]]" }
			]
		},
		{
			"template": "[data-source-code]",
			"test": "fn:guessType",
			"value": "/",
			"expect": "xsd:string",
			"append": true,
			"mapping": [
				{ "selector": "code", "value": "/@value" },
				{ "selector": "[data-btn-remove]", "value": "/_:iterator", "attr": "path", "placeholder": "[[-id-]]" }
			]
		},
		{
			"template": "[data-asset-image]",
			"test": "fn:guessType",
			"value": "/",
			"expect": "acr:AttachmentImage",
			"append": true,
			"mapping": [
				{ "selector": "img", "value": "/acr:content/@value", "attr": "src" },
				{ "selector": "a", "value": "/acr:content/@value", "attr": "href" },
				{ "selector": "img", "value": "/dct:title", "attr": "alt" },
				{ "selector": "[data-caption]", "value": "/dct:title" },
				{ "selector": "[data-btn-remove]", "value": "/_:iterator", "attr": "path", "placeholder": "[[-id-]]" }

			]
		},
		{
			"template": "[data-asset-json]",
			"test": "fn:guessType",
			"value": "/",
			"expect": "rdf:JSON",
			"append": true,
