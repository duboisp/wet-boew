				{ "selector": "[data-outcome-b]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-outcome-c]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-outcome-d]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },
				{ "selector": "[data-outcome-e]", "value": "/_:iterator", "attr": "name", "placeholder": "[[-id-]]" },


