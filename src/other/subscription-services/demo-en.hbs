	<h2>Add a filter</h2>

	<script>
		var prevCheckState = {};
		function checkAll( elm ){

			if ( prevCheckState[ elm.name ] === elm.checked ) {
				return;
			}

			$( "[name='" + elm.name + "']" ).prop( "checked", elm.checked  );

			// Should we make it indeterminate when some are checked?
			// elm.indeterminate = true;

		}

		function checkInt( elm ) {

			// Prototype, intermediate selection
			var intCheckbox = document.querySelectorAll( "[name=newsType][value]" );

			var numberOfChecked = 0;

			for( var i = 0; i < intCheckbox.length; i++ ) {
				if ( intCheckbox[ i ].checked ) {
					numberOfChecked = numberOfChecked + 1;
				}
			}

			var protoCheckAll = document.getElementById( "protoCheckAll" );


			if ( numberOfChecked === intCheckbox.length ) {

				// They are all check
				protoCheckAll.checked = true;
				protoCheckAll.indeterminate = false;

			} else if ( numberOfChecked === 0 ) {

				// None are checked
				protoCheckAll.checked = false;
				protoCheckAll.indeterminate = false;

			} else {

				// Intermediate state
				protoCheckAll.checked = false;
				protoCheckAll.indeterminate = true;

			}

		}
		</script>

